# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/bztel_db"
DIRECT_URL="postgresql://user:password@localhost:5432/bztel_db"

# JWT Secret (MUST be at least 32 random characters in production)
JWT_SECRET=your-secure-32-byte-random-jwt-secret-key-here
ADMIN_EMAIL=admin@bztel.com
ADMIN_PASSWORD=your_strong_admin_password
PORT=3000

# Secret required to authorize the birthday-greeting cron trigger (app/api/cron/birthday).
# Sent as `Authorization: Bearer <value>`. MUST be set in production — the endpoint rejects
# ALL requests if this is unset (fails closed).
CRON_SECRET=your-secure-random-cron-secret-here

# Shared secret for the inbound SMS delivery-receipt (DLR) webhook (app/api/sms/dlr).
# Append as a `secret` query param on the webhook URL configured with Monty Mobile.
# Currently enforced as warn-only during rollout; will move to fail-closed once confirmed
# Monty Mobile is sending it correctly.
DLR_WEBHOOK_SECRET=your-dlr-webhook-secret-here

# Upstash / Redis Rate Limiting Configuration (Required for distributed multi-instance deployments)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Monty Mobile SMPP Gateway Configuration
SMPP_ENABLED=false
SMPP_HOST=185.135.128.117
SMPP_PORT=7500
SMPP_SYSTEM_TYPE=SMPP

# Transactional Account
SMPP_TX_SYSTEM_ID=BZTItms
SMPP_TX_PASSWORD=your_transactional_smpp_password

# Promotional Account
SMPP_PROMO_SYSTEM_ID=BZTIPrmo
SMPP_PROMO_PASSWORD=your_promotional_smpp_password

# Comma-separated promotional sender IDs list (all caps)
SMPP_PROMO_SENDER_IDS=BZTIPRMO

# Flutterwave Payment Gateway
FLW_PUBLIC_KEY="your_flutterwave_public_key"
FLW_SECRET_KEY="your_flutterwave_secret_key"

# OpenRouter AI API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

